NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Copy the project's sb_secret_... value manually from Supabase Dashboard > Settings > API Keys.
# Keep this server-only; do not rename it to NEXT_PUBLIC_SUPABASE_SECRET_KEY.
SECRET_KEY=sb_secret_your_key

# Server-only key used by SDD-004 wardrobe image recognition.
# Never expose this value with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=your_openai_api_key

# Optional. Defaults to gpt-4o-mini when omitted.
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_LOOKBOOK_MODEL=gpt-image-2

# Optional. Defaults to gpt-4o-mini when omitted.
OPENAI_RECOMMENDATION_MODEL=gpt-4o-mini

# Server-only Baidu AI Cloud intelligent cutout credentials used by SDD-026.
# Selected garment originals are sent only when the current user triggers cutout processing.
# Never expose either value with a NEXT_PUBLIC_ prefix.
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key

# SDD-028 QWeather: all server-only. Never prefix with NEXT_PUBLIC_.
# The browser receives only a short-lived JWT from the authenticated session route.
QWEATHER_API_HOST=your-host.re.qweatherapi.com
QWEATHER_DEVELOPER_ID=your_developer_id
QWEATHER_PROJECT_ID=your_project_id
QWEATHER_CREDENTIAL_ID=your_credential_id
QWEATHER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_ED25519_PRIVATE_KEY\n-----END PRIVATE KEY-----"

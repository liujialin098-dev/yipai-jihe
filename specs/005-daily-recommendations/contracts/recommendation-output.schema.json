{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily recommendation output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "outfits": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slot": { "type": "integer", "enum": [1, 2, 3] },
          "title": { "type": "string", "minLength": 1, "maxLength": 30 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 140 },
          "styleTags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "minimal",
                "casual",
                "commute",
                "elegant",
                "sporty",
                "vintage"
              ]
            }
          },
          "itemIds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": { "type": "string" }
          }
        },
        "required": ["slot", "title", "reason", "styleTags", "itemIds"]
      }
    }
  },
  "required": ["outfits"]
}
